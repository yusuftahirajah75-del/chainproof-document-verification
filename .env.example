# =================================================================
# CHAINPROOF: BLOCKCHAIN-BASED DOCUMENT INTEGRITY VERIFICATION SYSTEM
# Environment Configuration Template
# =================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
# Option A: Full Connection String (Render PostgreSQL / Cloud Database)
DATABASE_URL=postgres://username:password@hostname:5432/chainproof

# Option B: Individual Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chainproof_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_SSL=false

# Authentication & Session Security
JWT_SECRET=super_secret_jwt_chainproof_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h
COOKIE_SECRET=super_secret_cookie_parser_secret_change_in_prod
COOKIE_SECURE=false

# Document Storage & Upload Limits
UPLOAD_STORAGE_DIR=./storage/documents
UPLOAD_MAX_FILE_SIZE_MB=15

# Blockchain Configuration (Hardhat / Localhost / Testnet)
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
# Default Hardhat account #0 private key for local development
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=20

